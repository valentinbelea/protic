@{
    ViewData["Title"] = Localizer["Login"];
}

<div class="row justify-content-center mt-5">
    <div class="col-md-4">
        <h2 class="text-center mb-4">@Localizer["Login"]</h2>
        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }
        <form asp-action="Login" method="post" class="card p-4 shadow-sm">
            <input type="hidden" name="returnUrl" value="@Context.Request.Query["ReturnUrl"]" />
            <div class="mb-3">
                <label for="username" class="form-label">@Localizer["Username"]</label>
                <input type="text" class="form-control" id="username" name="username" required />
            </div>
            <div class="mb-3">
                <label for="password" class="form-label">@Localizer["Password"]</label>
                <input type="password" class="form-control" id="password" name="password" required />
            </div>
            <button type="submit" class="btn btn-primary w-100">@Localizer["Login"]</button>
        </form>
    </div>
</div>
