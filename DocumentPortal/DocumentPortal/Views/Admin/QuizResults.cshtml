@model IEnumerable<DocumentPortal.Models.QuizSubmission>
@{
    var quiz = ViewBag.Quiz as DocumentPortal.Models.Quiz;
    ViewData["Title"] = @Localizer["Quiz Results"] + " - " + quiz?.Title;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>@Localizer["Results for:"] @quiz?.Title</h2>
    <a asp-action="Quizzes" class="btn btn-secondary">@Localizer["Back to Quizzes"]</a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="alert alert-info mb-0">
                @Localizer["No users have taken this quiz yet."]
            </div>
        }
        else
        {
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>@Localizer["User"]</th>
                        <th>@Localizer["Date Taken"]</th>
                        <th>@Localizer["Score"]</th>
                        <th class="text-end">@Localizer["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sub in Model)
                    {
                        var percentage = sub.TotalQuestions > 0 ? ((double)sub.Score / sub.TotalQuestions) * 100 : 0;
                        <tr>
                            <td><i class="bi bi-person-circle me-2 text-muted"></i><strong>@sub.User?.Username</strong></td>
                            <td>@sub.SubmissionDate.ToLocalTime().ToString("g")</td>
                            <td>
                                <span class="badge @(percentage >= 80 ? "bg-success" : (percentage >= 50 ? "bg-warning" : "bg-danger")) px-2 py-1 fs-6">
                                    @(Math.Round(percentage))% (@sub.Score / @sub.TotalQuestions)
                                </span>
                            </td>
                            <td class="text-end">
                                <form asp-action="ResetQuizSubmission" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@sub.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('@Localizer["Are you sure you want to reset this user\'s submission? They will have to take the quiz again."]');">
                                        <i class="bi bi-arrow-counterclockwise me-1"></i> @Localizer["Reset"]
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
