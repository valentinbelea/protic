@model IEnumerable<DocumentPortal.Models.Menu>
@{
    ViewData["Title"] = @Localizer["Manage Menus"];
}

<div class="row">
    <div class="col-md-4">
        <h3>@Localizer["Add New Menu"]</h3>
        <form asp-action="AddMenu" method="post" class="card p-3 mb-4 shadow-sm">
            <div class="mb-3">
                <label for="@Localizer["Name"]" class="form-label">@Localizer["Name"]</label>
                <input type="text" class="form-control" id="@Localizer["Name"]" name="@Localizer["Name"]" required />
            </div>
            <div class="mb-3">
                <label for="@Localizer["Order"]" class="form-label">@Localizer["Order"]</label>
                <input type="number" class="form-control" id="@Localizer["Order"]" name="@Localizer["Order"]" value="0" required />
            </div>
            <button type="submit" class="btn btn-success">@Localizer["Add Menu"]</button>
        </form>
    </div>
    <div class="col-md-8">
        <h3>@Localizer["Existing Menus"]</h3>
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>@Localizer["Name"]</th>
                    <th>@Localizer["Order"]</th>
                    <th>@Localizer["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var menu in Model)
                {
                    <tr>
                        <td>@menu.Name</td>
                        <td>@menu.Order</td>
                        <td>
                            <a asp-action="EditMenu" asp-route-id="@menu.Id" class="btn btn-primary btn-sm me-1">@Localizer["Edit"]</a>
                            <form asp-action="DeleteMenu" method="post" style="display:inline;">
                                <input type="hidden" name="id" value="@menu.Id" />
                                <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('@Localizer["Delete this menu?"]"]');">@Localizer["Delete"]</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
