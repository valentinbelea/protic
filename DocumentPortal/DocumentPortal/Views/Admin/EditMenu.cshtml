@model DocumentPortal.Models.Menu
@{
    ViewData["Title"] = @Localizer["Edit Menu"];
}

<div class="row">
    <div class="col-md-6 offset-md-3">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">@Localizer["Edit Menu"]</h4>
            </div>
            <div class="card-body">
                <form asp-action="EditMenu" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">@Localizer["Name"]</label>
                        <input asp-for="Name" type="text" class="form-control" required />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="Order" class="form-label">@Localizer["Order"]</label>
                        <input asp-for="Order" type="number" class="form-control" min="0" required />
                        <span asp-validation-for="Order" class="text-danger"></span>
                    </div>
                    
                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Menus" class="btn btn-secondary">@Localizer["Cancel"]</a>
                        <button type="submit" class="btn btn-success">@Localizer["Save Changes"]</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
