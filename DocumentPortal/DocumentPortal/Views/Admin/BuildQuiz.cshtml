@model DocumentPortal.Models.Quiz
@using System.Text.Json
@{
    ViewData["Title"] = Localizer["Build Quiz"];
    
    var quizModel = new {
        Id = Model.Id,
        Questions = Model.Questions.Select(q => new {
            Text = q.Text,
            IsMultipleChoice = q.IsMultipleChoice,
            AnswerOptions = q.AnswerOptions.Select(a => new {
                Text = a.Text,
                IsCorrect = a.IsCorrect
            }).ToList()
        }).ToList()
    };
    var initialDataJson = JsonSerializer.Serialize(quizModel);
}

<h2>@Localizer["Build Quiz"] - @Model.Title</h2>
<p class="text-muted">@Localizer["Add questions and set their answer options. Check the box if an answer is correct."]</p>
<hr />

<div id="quiz-builder-app" class="mb-5">
    <div id="questions-container">
        <!-- Questions will be rendered here via JS -->
    </div>
    <div class="mt-4">
        <button type="button" class="btn btn-outline-primary" id="btn-add-question">
            <i class="bi bi-plus-circle me-1"></i> @Localizer["Add Question"]
        </button>
        <button type="button" class="btn btn-success ms-2" id="btn-save-quiz">
            <i class="bi bi-save me-1"></i> @Localizer["Save Quiz"]
        </button>
        <a asp-action="Quizzes" class="btn btn-secondary ms-2">@Localizer["Back"]</a>
    </div>

    <!-- Templates -->
    <template id="question-template">
        <div class="card mb-4 shadow-sm question-card">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <h5 class="mb-0 question-title">@Localizer["Question"]</h5>
                <button type="button" class="btn btn-sm btn-danger btn-remove-question">@Localizer["Remove"]</button>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">@Localizer["Question Text"]</label>
                    <input type="text" class="form-control question-text" required />
                </div>
                <div class="mb-3 form-check">
                    <input type="checkbox" class="form-check-input question-multiple" />
                    <label class="form-check-label">@Localizer["Is Multiple Choice (allows multiple correct answers)"]</label>
                </div>
                
                <h6 class="mt-4">@Localizer["Answers"]</h6>
                <div class="answers-container"></div>
                
                <button type="button" class="btn btn-sm btn-outline-secondary mt-2 btn-add-answer">
                    <i class="bi bi-plus me-1"></i> @Localizer["Add Answer"]
                </button>
            </div>
        </div>
    </template>
    
    <template id="answer-template">
        <div class="d-flex align-items-center mb-2 answer-row">
            <div class="form-check me-2 mb-0">
                <input class="form-check-input answer-correct" type="checkbox" title="@Localizer["Mark as correct"]">
            </div>
            <input type="text" class="form-control answer-text form-control-sm me-2" placeholder="@Localizer["Answer text"]" required />
            <button type="button" class="btn btn-sm btn-outline-danger btn-remove-answer"><i class="bi bi-trash"></i></button>
        </div>
    </template>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            var state = @Html.Raw(initialDataJson);
            var $container = $('#questions-container');
            
            function render() {
                $container.empty();
                state.Questions.forEach((q, qIndex) => {
                    var $qEl = $($('#question-template').html());
                    $qEl.find('.question-title').text('@Localizer["Question"] ' + (qIndex + 1));
                    $qEl.find('.question-text').val(q.Text).on('input', function() { q.Text = $(this).val(); });
                    $qEl.find('.question-multiple').prop('checked', q.IsMultipleChoice).on('change', function() { q.IsMultipleChoice = $(this).is(':checked'); });
                    
                    var $answersContainer = $qEl.find('.answers-container');
                    q.AnswerOptions.forEach((a, aIndex) => {
                        var $aEl = $($('#answer-template').html());
                        $aEl.find('.answer-text').val(a.Text).on('input', function() { a.Text = $(this).val(); });
                        $aEl.find('.answer-correct').prop('checked', a.IsCorrect).on('change', function() {
                            if (!q.IsMultipleChoice && $(this).is(':checked')) {
                                // uncheck others
                                q.AnswerOptions.forEach(opt => opt.IsCorrect = false);
                                render(); // Re-render to show only one checked
                                q.AnswerOptions[aIndex].IsCorrect = true;
                            } else {
                                a.IsCorrect = $(this).is(':checked');
                            }
                        });
                        $aEl.find('.btn-remove-answer').on('click', function() {
                            q.AnswerOptions.splice(aIndex, 1);
                            render();
                        });
                        $answersContainer.append($aEl);
                    });
                    
                    $qEl.find('.btn-add-answer').on('click', function() {
                        q.AnswerOptions.push({ Text: '', IsCorrect: false });
                        render();
                    });
                    
                    $qEl.find('.btn-remove-question').on('click', function() {
                        state.Questions.splice(qIndex, 1);
                        render();
                    });
                    
                    $container.append($qEl);
                });
            }
            
            $('#btn-add-question').on('click', function() {
                state.Questions.push({ Text: '', IsMultipleChoice: false, AnswerOptions: [] });
                render();
            });
            
            $('#btn-save-quiz').on('click', function() {
                var btn = $(this);
                btn.prop('disabled', true).text('@Localizer["Saving..."]');
                
                $.ajax({
                    url: '/Admin/SaveQuiz/' + state.Id,
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(state),
                    success: function() {
                        alert('@Localizer["Quiz saved successfully!"]');
                        window.location.href = '/Admin/Quizzes';
                    },
                    error: function() {
                        alert('@Localizer["Error saving quiz."]');
                        btn.prop('disabled', false).text('@Localizer["Save Quiz"]');
                    }
                });
            });
            
            // Initial render
            if (state.Questions.length === 0) {
                state.Questions.push({ Text: '', IsMultipleChoice: false, AnswerOptions: [{ Text: '', IsCorrect: true }, { Text: '', IsCorrect: false }] });
            }
            render();
        });
    </script>
}
