<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Protic</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lexend:wght@400;500;700&family=Caveat:wght@600;700&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DocumentPortal.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header class="pt-header">
        <div class="pt-header__inner">
            <a class="pt-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <svg width="42" height="42" viewBox="0 0 42 42" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="36" height="36" rx="5"></rect><path d="M28 12H14l8 9-8 9h14"></path></svg>
                <span class="pt-brand__name">Protic</span>
            </a>

            @await Component.InvokeAsync("Navigation")

            <ul class="pt-header__actions">
                <li class="dropdown">
                    <button class="pt-btn pt-btn--ghost dropdown-toggle" type="button" id="navbarLang" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-translate" aria-hidden="true"></i> @Localizer["Language"]
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarLang">
                        <li>
                            <form asp-controller="Home" asp-action="SetLanguage" method="post">
                                <input type="hidden" name="culture" value="ro" />
                                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                <button type="submit" class="dropdown-item" lang="ro">Română</button>
                            </form>
                        </li>
                        <li>
                            <form asp-controller="Home" asp-action="SetLanguage" method="post">
                                <input type="hidden" name="culture" value="en" />
                                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                <button type="submit" class="dropdown-item" lang="en">English</button>
                            </form>
                        </li>
                    </ul>
                </li>

                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <li class="dropdown">
                        <button class="pt-btn pt-btn--outline dropdown-toggle" type="button" id="navbarUser" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person" aria-hidden="true"></i> @User.Identity.Name
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarUser">
                            @if (User.IsInRole("Admin"))
                            {
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="Index"><i class="bi bi-gear me-2" aria-hidden="true"></i> @Localizer["Administration"]</a></li>
                                <li><hr class="dropdown-divider"></li>
                            }
                            <li>
                                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="dropdown-item">
                                        <i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i> @Localizer["Logout"]
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </li>
                }
                else
                {
                    <li>
                        <a class="pt-btn pt-btn--primary" asp-controller="Account" asp-action="Login">@Localizer["Login"]</a>
                    </li>
                }
            </ul>
        </div>
    </header>

    <main role="main" class="flex-grow-1">
        <div class="pt-page">
            @RenderBody()
        </div>
    </main>

    <footer class="pt-footer">
        <div class="pt-footer__inner">
            <span>&copy; @DateTime.Now.Year Protic</span>
            <a asp-area="" asp-controller="Home" asp-action="Privacy">@Localizer["Privacy Policy"]</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
