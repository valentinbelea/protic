@model IEnumerable<DocumentPortal.Models.Menu>
@{
    var routeValues = ViewContext.RouteData.Values;
    bool onMenuPage = string.Equals(routeValues["controller"]?.ToString(), "Home", StringComparison.OrdinalIgnoreCase)
                      && string.Equals(routeValues["action"]?.ToString(), "Menu", StringComparison.OrdinalIgnoreCase);
    var currentId = onMenuPage ? routeValues["id"]?.ToString() : null;
}

<nav class="pt-nav" aria-label="@Localizer["Main menu"]">
    @foreach (var menu in Model)
    {
        bool isActive = currentId == menu.Id.ToString();
        <a class="pt-nav__link @(isActive ? "is-active" : null)" aria-current="@(isActive ? "page" : null)"
           asp-area="" asp-controller="Home" asp-action="Menu" asp-route-id="@menu.Id">@menu.Name</a>
    }

    @if (User.Identity != null && User.IsInRole("Admin"))
    {
        <a class="pt-nav__link pt-nav__link--admin" asp-area="" asp-controller="Admin" asp-action="Index">@Localizer["Administration"]</a>
    }
</nav>
