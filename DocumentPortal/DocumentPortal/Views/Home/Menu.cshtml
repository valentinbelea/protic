@model DocumentPortal.Models.Menu

@{
    ViewData["Title"] = Model.Name;
    bool isAuthenticated = User.Identity != null && User.Identity.IsAuthenticated;

    // Short label + marker color for a document, from its file extension
    (string Label, string Css) DocTag(DocumentPortal.Models.Document doc)
    {
        if (doc.FilePath == null) return ("TEXT", "pt-tag--green");
        var ext = System.IO.Path.GetExtension(doc.FileName ?? doc.FilePath).TrimStart('.').ToUpperInvariant();
        if (string.IsNullOrEmpty(ext)) return ("FILE", "pt-tag--blue");
        return (ext.Length > 4 ? ext.Substring(0, 4) : ext, ext == "PDF" ? "" : "pt-tag--blue");
    }
}

<div class="pt-margin">
    <div class="pt-title">
        <span class="pt-hand pt-title__eyebrow">@Localizer["current chapter"]</span>
        <h1>@Model.Name</h1>
    </div>

    @if (!Model.Sections.Any())
    {
        <div class="pt-notice">@Localizer["No sections available under this menu."]</div>
    }
    else
    {
        <div class="pt-sections">
            @foreach (var section in Model.Sections)
            {
                if (section.IsPrivate && !isAuthenticated)
                {
                    <section class="pt-card pt-card--locked">
                        <div class="pt-card__head">
                            <h2 class="pt-card__title"><i class="bi bi-lock" aria-hidden="true"></i>@(section.Title)</h2>
                            <span class="pt-badge">@Localizer["Private"]</span>
                        </div>
                        <div class="pt-card__body d-flex flex-column align-items-start gap-3">
                            <p class="mb-0 text-muted">@Localizer["This section is private and requires authentication."]</p>
                            <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path" class="pt-btn pt-btn--outline">@Localizer["Login to View Details"]</a>
                        </div>
                    </section>
                }
                else
                {
                    <section class="pt-card">
                        <div class="pt-card__head">
                            <h2 class="pt-card__title">@(section.Title)</h2>
                            @if (section.IsPrivate)
                            {
                                <span class="pt-badge pt-badge--soft"><i class="bi bi-shield-lock" aria-hidden="true"></i> @Localizer["Private Access"]</span>
                            }
                        </div>
                        <div class="pt-card__body">
                            @if (!section.Documents.Any())
                            {
                                <p class="pt-card__empty">@Localizer["No documents have been uploaded to this section yet."]</p>
                            }
                            else
                            {
                                <ul class="pt-docs">
                                    @foreach (var doc in section.Documents)
                                    {
                                        var tag = DocTag(doc);
                                        <li class="pt-doc">
                                            <div class="pt-doc__row">
                                                <span class="pt-tag @tag.Css">@tag.Label</span>
                                                <span class="pt-doc__name">@doc.Description</span>
                                                @if (doc.FilePath != null)
                                                {
                                                    <a href="/uploads/@doc.FilePath" class="pt-link" target="_blank" download="@doc.FileName">
                                                        <i class="bi bi-download" aria-hidden="true"></i> @Localizer["Download"]
                                                    </a>
                                                }
                                            </div>
                                            @if (doc.FilePath == null && !string.IsNullOrWhiteSpace(doc.Content))
                                            {
                                                <div class="pt-doc__content">@doc.Content</div>
                                            }
                                        </li>
                                    }
                                </ul>
                            }

                            @if (section.Quizzes != null && section.Quizzes.Any())
                            {
                                <h3 class="visually-hidden">@Localizer["Section Quizzes"]</h3>
                                @foreach (var quiz in section.Quizzes)
                                {
                                    <div class="pt-quiz">
                                        <div class="pt-quiz__info">
                                            <i class="bi bi-ui-checks fs-3" aria-hidden="true"></i>
                                            <div>
                                                <div class="pt-quiz__title">@quiz.Title</div>
                                                @if (!string.IsNullOrEmpty(quiz.Description))
                                                {
                                                    <div class="pt-quiz__desc">@quiz.Description</div>
                                                }
                                            </div>
                                        </div>
                                        <a asp-controller="Home" asp-action="TakeQuiz" asp-route-id="@quiz.Id" class="pt-btn pt-btn--primary">@Localizer["Take Quiz"]</a>
                                    </div>
                                }
                            }
                        </div>
                    </section>
                }
            }
        </div>
    }
</div>
